{
  "name": "git-viewer",
  "version": "0.1.6",
  "scripts": {
    "ng": "ng",
    "start": "ng build && electron .",
    "build": "ng build",
    "dist": "ng build && electron-builder --win",
    "dist:mac": "ng build && electron-builder --mac",
    "dist:linux": "ng build && electron-builder --linux",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "ng serve",
    "dev:electron": "electron . --dev",
    "test:graph": "node --test src/app/graph.spec.ts"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "ngx-scrollbar": "^19.1.5",
    "postcss": "^8.5.30",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@spartan-ng/cli": "^1.7.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "electron@44.7.2": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "main": "electron/main.cjs",
  "description": "Desktop git client",
  "author": "dmauro13",
  "build": {
    "appId": "it.albaconsulting.gitviewer",
    "productName": "Git Viewer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/git-viewer/browser/**",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "dmauro13 <info@albaconsulting.it>",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Git Viewer",
      "include": "build/installer.nsh"
    }
  }
}
